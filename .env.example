# Docker dev stack settings. compose.yaml reads this file as .env; dev/setup.sh
# copies it there and fills in the blanks. Next.js and the Convex CLI also read
# .env, which is why nothing here uses their variable names.

# This machine's Tailscale name and IPv4. The stack is served at
# https://$DEV_HOST:<port> and Caddy binds only to DEV_BIND_IP (tailnet-only).
DEV_HOST=
DEV_BIND_IP=

# HTTPS ports on DEV_HOST: the app, the Convex API, Convex HTTP actions, and
# the Convex dashboard.
WEB_PORT=8444
CONVEX_PORT=8445
SITE_PORT=8446
DASHBOARD_PORT=8447

# Admin key for the self-hosted Convex backend. dev/setup.sh derives it from
# the instance secret in the convex-data volume.
CONVEX_ADMIN_KEY=

# The seeded dev admin account (dev/setup.sh generates the password).
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=

# CARTO basemaps key for the map tiles (free, no account:
# https://carto.com/basemaps/apikey). Restrict it to $DEV_HOST in CARTO's
# dashboard, or use a separate key from production's.
CARTO_BASEMAPS_KEY=
